## Constants for the install.sh script
scriptname=$(basename "$0")
logFile="${HOME}/sArch-install.log"
RED="\e[31m"
GREEN="\e[32m"
YELLOW="\e[1;33m"
WHITE="\e[1;37m"
NC="\e[0m"
CROSS="\u2717"
CHECK="\u2713"
RUNNING="${YELLOW}•${NC}"
ERROR="${RED}${CROSS}${NC}"
MYOK="${GREEN}${CHECK}${NC}"
UP="\e[A"
CLEAR="\r                                        \r"
pacmanRun="sudo pacman -S --noconfirm --needed"
declare -A checkDefaults
checkDefaults["hostname"]="sArch"
checkDefaults["user"]="schnubby"
checkDefaults["timezone"]="Europe/Berlin"
checkDefaults["locale"]="de_DE.UTF-8"
checkDefaults["keymap"]="de-latin1"
checkDefaults["kernel"]="linux-lts"
menuEntries=("Settings" "Install" "Exit")
