## All the settings sARCH needs for an installation
debug=false
dryRun=false
defaults=false
boot="/dev/vda1"
swap="/dev/vda2"
root="/dev/vda3"
hostname="SchnuBbyLinux"
user="schnubby"
cpu="intel-ucode"
gpu="amd"
timezone="Europe/Berlin"
locale="de_DE.UTF-8"
keymap="de-latin1"
kernel="linux-lts"
BACKUP_DEV="/dev/nvme0n1p4"
BACKUP_MNT="/programmieren"
BACKUP_DIR="$BACKUP_MNT/backups"
GAMES_DEV="/dev/nvme0n1p6"
GAMES_MNT="/spiele"
