#############
# Please only edit this part
[global]
origin = top-center
font = "Don Graffiti 15"
############
follow = mouse
corner_radius = 10
progress_bar_corner_radius = 10
layer = top
#icon_theme = "Matugen"
alignment = center
format = "<b>%a</b>\n%c\n%s"
history_ignore = true
foreground = "#000000FF"
############
background = "{{colors.primary.default.hex}}B0"
frame_color = "{{colors.secondary.default.hex}}FF"
highlight = "{{colors.secondary.default.hex}}FF"

# Hintergrundbild-Wechsel (Settings-App): Bild groß oben anzeigen
[sarch_wallpaper]
    category = "Wallpaper changed"
    icon_position = top
    min_icon_size = 0
    max_icon_size = 320
